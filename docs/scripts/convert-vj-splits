#!/bin/bash
# Split one local video, or every video in a folder, into clips (stream copy).
# Default length is 55s. `make convert-vj-splits-20s` passes VJ_SPLIT_SEGMENT_SEC=20.
# A folder gets one subfolder per filename. Files that share the text before __ share a subfolder.
# Cuts follow keyframes, so a clip can be a little shorter or longer than that.
# Filenames use the boundaries FFmpeg actually wrote.
set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=vj-job-common.sh
source "${SCRIPT_DIR}/vj-job-common.sh"
# shellcheck source=vj-limits.sh
source "${SCRIPT_DIR}/vj-limits.sh"
# shellcheck source=vj-split-names.sh
source "${SCRIPT_DIR}/vj-split-names.sh"
vj_split_apply_segment_sec || exit 1

JOB=convert-vj-splits
LOG="${VJ_CACHE}/convert-vj-splits.log"

VIDEO=""
OUT=""
STEM=""
FFMPEG_PID=""
STOP_MODE=""
FINALIZED=0
RENAMED=0
CSV_FOR_RENAME=""
ON_TERM=0
FILE_DONE_BASE=0
TIME_OFFSET=""
CLEAR_OUT=1
FOLDER_MODE=0
FOLDER_PATH=""
FILE_FAILED=0
GROUP_LIST=""

log() { vj_log "$LOG" "$@"; }

fail() {
  log "FAIL: $*"
  if [[ -n "${GROUP_LIST:-}" ]]; then
    rm -f "$GROUP_LIST" "${GROUP_LIST}.groups"
  fi
  if [[ -n "${OUT:-}" ]]; then
    rm -f "$OUT/.source-path"
    vj_split_clear_source_marker "$OUT"
  fi
  vj_state_set "$JOB" PHASE "failed"
  vj_state_set "$JOB" CURRENT ""
  vj_print_summary "$JOB" "$LOG" "$(vj_splits_label)"
  exit 1
}

count_completed() {
  if [[ -z "$OUT" || ! -f "$OUT/segments.csv" ]]; then
    echo 0
    return 0
  fi
  awk -F, 'NF >= 3 && $1 ~ /\.mp4$/ { c++ } END { print c + 0 }' "$OUT/segments.csv"
}

capture_csv() {
  local expect="${1:-0}" tries=0 n=0
  CSV_FOR_RENAME=""
  [[ -n "$OUT" && -d "$OUT" ]] || return 0
  CSV_FOR_RENAME="$OUT/.segments.keep.csv"
  while [[ "$tries" -lt 10 ]]; do
    if [[ -f "$OUT/segments.csv" ]]; then
      awk -F, 'NF >= 3 && $1 ~ /\.mp4$/ { print }' "$OUT/segments.csv" >"$CSV_FOR_RENAME"
    else
      : >"$CSV_FOR_RENAME"
    fi
    n=$(wc -l <"$CSV_FOR_RENAME" | tr -d ' ')
    n=${n:-0}
    if [[ "$n" -ge "$expect" ]]; then
      return 0
    fi
    tries=$((tries + 1))
    sleep 0.1
  done
  return 0
}

remove_temp_files() {
  local f saved=0
  [[ -n "$OUT" && -d "$OUT" ]] || return 0
  shopt -q nullglob && saved=1
  shopt -s nullglob
  for f in "$OUT"/part_[0-9][0-9][0-9][0-9].mp4; do
    case "$f" in
      "$OUT"/*) rm -f "$f" ;;
    esac
  done
  if [[ "$saved" -eq 0 ]]; then
    shopt -u nullglob
  fi
  rm -f "$OUT/segments.csv" "$OUT/.segments.keep.csv" "$OUT/.source-path"
}

finalize_files() {
  local file start end from to dest n=0 src seq=2
  [[ "$FINALIZED" -eq 1 ]] && return 0
  FINALIZED=1
  [[ -n "$OUT" && -d "$OUT" ]] || return 0
  src="$CSV_FOR_RENAME"
  if [[ -z "$src" || ! -f "$src" ]]; then
    src="$OUT/segments.csv"
  fi
  if [[ -f "$src" ]]; then
    while IFS=, read -r file start end || [[ -n "${file:-}" ]]; do
      file=${file//$'\r'/}
      start=${start//$'\r'/}
      end=${end//$'\r'/}
      file=$(basename "$file")
      [[ -n "$file" && -f "$OUT/$file" ]] || continue
      if [[ -n "${TIME_OFFSET:-}" ]]; then
        start=$(awk -v a="${start:-0}" -v b="$TIME_OFFSET" 'BEGIN { printf "%.3f", (a+0)+(b+0) }')
        end=$(awk -v a="${end:-0}" -v b="$TIME_OFFSET" 'BEGIN { printf "%.3f", (a+0)+(b+0) }')
      fi
      from=$(vj_split_fmt_hms "${start:-0}")
      to=$(vj_split_fmt_hms "${end:-0}")
      dest="${STEM}__${from}_to_${to}.mp4"
      if [[ -e "$OUT/$dest" && "$dest" != "$file" ]]; then
        seq=2
        dest="${STEM}__${from}_to_${to}_$(printf '%02d' "$seq").mp4"
        while [[ -e "$OUT/$dest" && "$dest" != "$file" ]]; do
          seq=$((seq + 1))
          dest="${STEM}__${from}_to_${to}_$(printf '%02d' "$seq").mp4"
        done
      fi
      if [[ "$file" != "$dest" ]]; then
        mv -f "$OUT/$file" "$OUT/$dest"
      fi
      log "OK: ${OUT}/${dest}"
      n=$((n + 1))
    done <"$src"
  fi
  RENAMED=$n
  FILE_DONE_BASE=$((FILE_DONE_BASE + RENAMED))
  vj_state_set "$JOB" DONE "$FILE_DONE_BASE"
  remove_temp_files
}

clear_previous_clips() {
  local f n=0 saved=0
  shopt -q nullglob && saved=1
  shopt -s nullglob
  for f in "$OUT"/*.mp4; do
    case "$f" in
      "$OUT"/*) rm -f "$f" ;;
    esac
    n=$((n + 1))
  done
  if [[ "$saved" -eq 0 ]]; then
    shopt -u nullglob
  fi
  rm -f "$OUT/segments.csv" "$OUT/.segments.keep.csv"
  if [[ "$n" -gt 0 ]]; then
    log "Replacing ${n} existing clip(s) in ${OUT}"
  fi
}

start_ffmpeg() {
  trap - EXIT TERM INT
  cd "$OUT" || {
    echo "cannot cd to $OUT" >>"$LOG"
    exit 1
  }
  vj_run_ffmpeg -nostdin -y -i "$VIDEO" \
    -map 0 -c copy \
    -f segment -segment_time "$VJ_SPLIT_SEGMENT_SEC" \
    -reset_timestamps 1 \
    -segment_list segments.csv \
    -segment_list_type csv \
    "part_%04d.mp4" >>"$LOG" 2>&1
}

on_term() {
  [[ "$ON_TERM" -eq 1 ]] && exit 0
  ON_TERM=1
  STOP_MODE="signal"
  # Drop a lock this process may have been holding when the signal arrived.
  vj_state_unlock "$JOB"
  if [[ -n "$FFMPEG_PID" ]] && kill -0 "$FFMPEG_PID" 2>/dev/null; then
    capture_csv 0
    vj_kill_tree "$FFMPEG_PID" || true
    sleep 0.2
  elif [[ -n "$OUT" ]]; then
    capture_csv 0
  fi
  finalize_files || true
  if [[ -n "${GROUP_LIST:-}" ]]; then
    rm -f "$GROUP_LIST" "${GROUP_LIST}.groups"
  fi
  vj_state_set "$JOB" PHASE "stopped"
  vj_state_set "$JOB" CURRENT ""
  exit 0
}

# Split $VIDEO into $OUT. CLEAR_OUT=1 replaces clips already in that folder.
# Returns 2 when this file should be the last one.
split_current() {
  local duration estimate showing file_done done_n baseline="" ffmpeg_rc=0

  FINALIZED=0
  CSV_FOR_RENAME=""
  FFMPEG_PID=""
  STOP_MODE=""
  RENAMED=0

  if vj_split_is_dataless "$VIDEO"; then
    if [[ "$FOLDER_MODE" == 1 ]]; then
      log "SKIP: not downloaded yet: $VIDEO"
      FILE_FAILED=$((FILE_FAILED + 1))
      return 1
    fi
    fail "file is in iCloud and not downloaded yet: $VIDEO"
  fi
  if ! vj_split_has_video "$VIDEO"; then
    if [[ "$FOLDER_MODE" == 1 ]]; then
      log "SKIP: no video stream: $VIDEO"
      FILE_FAILED=$((FILE_FAILED + 1))
      return 1
    fi
    fail "no video stream: $VIDEO"
  fi
  duration=$(vj_split_duration "$VIDEO")
  if ! vj_split_is_number "$duration"; then
    if [[ "$FOLDER_MODE" == 1 ]]; then
      log "SKIP: could not read duration: $VIDEO"
      FILE_FAILED=$((FILE_FAILED + 1))
      return 1
    fi
    fail "could not read duration: $VIDEO"
  fi

  estimate=$(vj_split_estimate_count "$duration")
  [[ "$estimate" =~ ^[0-9]+$ ]] || estimate=0

  mkdir -p "$OUT" || fail "could not create $OUT"
  if [[ "$CLEAR_OUT" == 1 ]]; then
    if [[ "$FOLDER_MODE" == 1 ]]; then
      vj_split_set_source_marker "$OUT" "$FOLDER_PATH" || fail "could not write split source marker"
    else
      vj_split_set_source_marker "$OUT" "$VIDEO" || fail "could not write split source marker"
    fi
    clear_previous_clips
  fi

  vj_state_set "$JOB" OUTPUT "$OUT"
  vj_state_set "$JOB" PHASE "splitting"
  vj_state_set "$JOB" CURRENT "$(basename "$VIDEO") clip 1/~${estimate}"

  log "Splitting $(basename "$VIDEO") into about ${estimate} clip(s) of ${VJ_SPLIT_SEGMENT_SEC}s (keyframe aligned, stream copy)"
  log "Source: $VIDEO"
  log "Output: $OUT"

  start_ffmpeg &
  FFMPEG_PID=$!

  while kill -0 "$FFMPEG_PID" 2>/dev/null; do
    file_done=$(count_completed)
    [[ "$file_done" =~ ^[0-9]+$ ]] || file_done=0
    done_n=$((FILE_DONE_BASE + file_done))
    vj_state_set "$JOB" DONE "$done_n"
    showing=$((file_done + 1))
    if [[ "$estimate" -gt 0 && "$showing" -gt "$estimate" ]]; then
      showing=$estimate
    fi
    vj_state_set "$JOB" CURRENT "$(basename "$VIDEO") clip ${showing}/~${estimate}"
    if [[ "$(vj_state_get "$JOB" STOP_AFTER)" == "1" ]]; then
      if [[ -z "$baseline" ]]; then
        baseline=$file_done
        log "Stop-after-current: finishing clip $((file_done + 1)), then stopping."
      fi
      if [[ "$file_done" -gt "$baseline" ]]; then
        STOP_MODE="next"
        log "Stopping before the next clip."
        capture_csv "$file_done"
        vj_kill_tree "$FFMPEG_PID" || true
        break
      fi
    fi
    sleep 1
  done

  if [[ -n "$FFMPEG_PID" ]]; then
    wait "$FFMPEG_PID" 2>/dev/null || ffmpeg_rc=$?
  fi
  FFMPEG_PID=""

  if [[ "$STOP_MODE" != "next" && "$(vj_state_get "$JOB" STOP_AFTER)" == "1" && "$ffmpeg_rc" -eq 0 ]]; then
    STOP_MODE="next"
  fi

  if [[ "$STOP_MODE" == "next" ]]; then
    finalize_files
    return 2
  fi

  if [[ "$ffmpeg_rc" -ne 0 ]]; then
    capture_csv 0
    finalize_files
    log "FAIL: ffmpeg exited ${ffmpeg_rc} for $VIDEO"
    if [[ "$FOLDER_MODE" == 1 ]]; then
      FILE_FAILED=$((FILE_FAILED + 1))
      return 1
    fi
    vj_state_set "$JOB" PHASE "failed"
    vj_state_set "$JOB" CURRENT ""
    vj_print_summary "$JOB" "$LOG" "$(vj_splits_label)"
    exit 1
  fi

  capture_csv 0
  finalize_files
  if [[ "$RENAMED" -lt 1 ]]; then
    log "FAIL: no clips were written for $VIDEO"
    if [[ "$FOLDER_MODE" == 1 ]]; then
      FILE_FAILED=$((FILE_FAILED + 1))
      return 1
    fi
    vj_state_set "$JOB" PHASE "failed"
    vj_state_set "$JOB" CURRENT ""
    vj_print_summary "$JOB" "$LOG" "$(vj_splits_label)"
    exit 1
  fi
  return 0
}

finish_job() {
  local phase="$1"
  if [[ "$phase" == "finished" ]]; then
    vj_state_set "$JOB" TOTAL "$FILE_DONE_BASE"
  fi
  vj_state_set "$JOB" DONE "$FILE_DONE_BASE"
  vj_state_set "$JOB" PHASE "$phase"
  vj_state_set "$JOB" CURRENT ""
  if [[ "$phase" == "finished" ]]; then
    log "Finished: ${FILE_DONE_BASE} clip(s)"
  elif [[ "$phase" == "stopped_after_current" ]]; then
    vj_state_set "$JOB" STOP_AFTER "0"
    log "Stopped after the current clip (${FILE_DONE_BASE} clip(s) saved)."
  fi
  vj_print_summary "$JOB" "$LOG" "$(vj_splits_label)"
}

split_one_file() {
  local parent raw_stem stem folder_stem duration estimate rc=0 off=""

  parent=$(dirname "$VIDEO")
  if [[ ! -w "$parent" ]]; then
    fail "cannot write next to the source: $parent"
  fi
  if vj_split_is_dataless "$VIDEO"; then
    fail "file is in iCloud and not downloaded yet: $VIDEO"
  fi
  if ! vj_split_has_video "$VIDEO"; then
    fail "no video stream: $VIDEO"
  fi
  duration=$(vj_split_duration "$VIDEO")
  if ! vj_split_is_number "$duration"; then
    fail "could not read duration: $VIDEO"
  fi
  raw_stem=$(vj_split_sanitize "$(basename "${VIDEO%.*}")")
  stem=$(vj_split_clip_title "$VIDEO")
  folder_stem=$(vj_split_folder_stem "$VIDEO")
  STEM="$stem"
  TIME_OFFSET=""
  off=$(vj_split_name_start_sec "$VIDEO" || true)
  if [[ -n "$off" ]]; then
    TIME_OFFSET=$off
  fi
  OUT=$(vj_split_pick_dir "$parent" "$folder_stem" "$VIDEO") || fail "could not choose an output folder"
  if [[ "$OUT" == "$parent" || "$VIDEO" == "$OUT"/* ]]; then
    fail "refusing to write clips over the source folder"
  fi
  estimate=$(vj_split_estimate_count "$duration")
  [[ "$estimate" =~ ^[0-9]+$ ]] || estimate=0
  vj_state_set "$JOB" TOTAL "$estimate"
  CLEAR_OUT=1
  if [[ "$raw_stem" != "$stem" ]]; then
    log "Name shortened: ${raw_stem} -> ${stem}"
  fi
  split_current || rc=$?
  if [[ "$rc" -eq 2 ]]; then
    finish_job stopped_after_current
    exit 0
  fi
  if [[ "$rc" -ne 0 ]]; then
    exit 1
  fi
  finish_job finished
}

split_folder() {
  local list groups file key prev="" rc=0 off="" total=0 nfiles=0 duration estimate

  FOLDER_PATH="$VIDEO"
  FOLDER_MODE=1
  if [[ ! -w "$FOLDER_PATH" ]]; then
    fail "cannot write in the folder: $FOLDER_PATH"
  fi
  list=$(mktemp)
  GROUP_LIST="$list"
  vj_split_folder_candidates "$FOLDER_PATH" | sort >"$list"
  if [[ ! -s "$list" ]]; then
    rm -f "$list"
    GROUP_LIST=""
    fail "no video files in $FOLDER_PATH"
  fi

  groups="${list}.groups"
  : >"$groups"
  vj_state_set "$JOB" CURRENT "reading durations"
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    if vj_split_is_dataless "$file"; then
      log "SKIP: not downloaded yet: $file"
      FILE_FAILED=$((FILE_FAILED + 1))
      continue
    fi
    if ! vj_split_has_video "$file"; then
      log "SKIP: no video stream: $file"
      FILE_FAILED=$((FILE_FAILED + 1))
      continue
    fi
    duration=$(vj_split_duration "$file")
    if ! vj_split_is_number "$duration"; then
      log "SKIP: could not read duration: $file"
      FILE_FAILED=$((FILE_FAILED + 1))
      continue
    fi
    estimate=$(vj_split_estimate_count "$duration")
    [[ "$estimate" =~ ^[0-9]+$ ]] || estimate=0
    total=$((total + estimate))
    nfiles=$((nfiles + 1))
    printf '%s\t%s\n' "$(vj_split_group_key "$file")" "$file" >>"$groups"
  done <"$list"
  sort -o "$groups" "$groups"

  if [[ "$nfiles" -lt 1 ]]; then
    rm -f "$list" "$groups"
    GROUP_LIST=""
    fail "no video files could be read in $FOLDER_PATH"
  fi

  vj_state_set "$JOB" TOTAL "$total"
  log "Folder: $FOLDER_PATH (${nfiles} file(s), about ${total} clip(s) of ${VJ_SPLIT_SEGMENT_SEC}s)"

  prev=""
  while IFS=$'\t' read -r key file; do
    [[ -n "$key" && -n "$file" ]] || continue
    if [[ "$(vj_state_get "$JOB" STOP_AFTER)" == "1" ]]; then
      rm -f "$list" "$groups"
      GROUP_LIST=""
      finish_job stopped_after_current
      exit 0
    fi
    VIDEO="$file"
    STEM="$key"
    OUT="${FOLDER_PATH}/$(vj_split_group_dir_name "$key")"
    if [[ "$OUT" == "$FOLDER_PATH" || "$file" == "$OUT"/* ]]; then
      log "FAIL: refusing output folder $OUT"
      FILE_FAILED=$((FILE_FAILED + 1))
      continue
    fi
    TIME_OFFSET=""
    off=$(vj_split_name_start_sec "$file" || true)
    if [[ -n "$off" ]]; then
      TIME_OFFSET=$off
    fi
    if [[ "$key" != "$prev" ]]; then
      CLEAR_OUT=1
      prev=$key
      log "Group: $(vj_split_group_dir_name "$key")/"
    else
      CLEAR_OUT=0
    fi
    rc=0
    split_current || rc=$?
    if [[ "$rc" -eq 2 ]]; then
      rm -f "$list" "$groups"
      GROUP_LIST=""
      finish_job stopped_after_current
      exit 0
    fi
  done <"$groups"

  rm -f "$list" "$groups"
  GROUP_LIST=""
  if [[ "$FILE_DONE_BASE" -lt 1 ]]; then
    vj_state_set "$JOB" PHASE "failed"
    vj_state_set "$JOB" CURRENT ""
    log "FAIL: no clips were written"
    vj_print_summary "$JOB" "$LOG" "$(vj_splits_label)"
    exit 1
  fi
  if [[ "$FILE_FAILED" -gt 0 ]]; then
    log "Finished with ${FILE_FAILED} file(s) skipped or failed. ${FILE_DONE_BASE} clip(s) saved."
  fi
  finish_job finished
  if [[ "$FILE_FAILED" -gt 0 ]]; then
    exit 1
  fi
}

main() {
  local target="${1:-}"

  if [[ -z "$target" ]]; then
    echo "Usage: convert-vj-splits /path/to/video.mp4" >&2
    echo "       convert-vj-splits /path/to/folder" >&2
    exit 1
  fi
  if [[ ! -f "$target" && ! -d "$target" ]]; then
    echo "No video file or folder at: ${target}" >&2
    exit 1
  fi
  if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
    echo "ffmpeg is not installed. Install it with: brew install ffmpeg" >&2
    exit 1
  fi

  vj_job_acquire_pid "$JOB"
  trap 'rm -f "$(vj_pid_file "$JOB")"' EXIT
  trap 'on_term' TERM INT
  vj_state_set "$JOB" SEGMENT_SEC "$VJ_SPLIT_SEGMENT_SEC"

  if [[ "${VJ_BACKGROUND:-}" != "1" ]]; then
    vj_print_job_banner "$(vj_splits_label)" "make convert-vj-splits-status" "$LOG"
  fi

  vj_state_set "$JOB" PHASE "probing"
  vj_state_set "$JOB" DONE "0"
  vj_state_set "$JOB" TOTAL ""
  vj_state_set "$JOB" CURRENT "reading duration"
  vj_state_set "$JOB" STOP_AFTER "0"
  vj_state_set "$JOB" SOURCE "$target"
  vj_state_set "$JOB" OUTPUT ""

  VIDEO="$target"
  if [[ -d "$target" ]]; then
    split_folder
  else
    split_one_file
  fi
}

main "$@"
