#!/bin/bash
# Convert local media in the VJ inbox to 1280x720 H.264 MP4 (see convert_to_vj_format_instructions.md).
set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=vj-job-common.sh
source "${SCRIPT_DIR}/vj-job-common.sh"
# shellcheck source=vj-limits.sh
source "${SCRIPT_DIR}/vj-limits.sh"
# shellcheck source=vj-filename.sh
source "${SCRIPT_DIR}/vj-filename.sh"
# shellcheck source=vj-paths.sh
source "${SCRIPT_DIR}/vj-paths.sh"
# shellcheck source=vj-split-names.sh
source "${SCRIPT_DIR}/vj-split-names.sh"

INBOX="${VJ_CONVERT_INBOX}"
OUTBOX="${VJ_CONVERT_OUTBOX}"
ARCHIVE="${VJ_CONVERT_ARCHIVE}"
CACHE="${VJ_CACHE}"
LOG="${CACHE}/convert-vj.log"
JOB=convert-vj

VJ_W=1280
VJ_H=720
RES_TAG="${VJ_W}x${VJ_H}"

VIDEO_EXTS='mp4|mkv|mov|avi|webm|m4v|mpg|mpeg|wmv|flv|ts|m2ts'

mkdir -p "$INBOX" "$OUTBOX" "$ARCHIVE" "$CACHE"

log() { vj_log "$LOG" "$@"; }

is_video_file() {
  local f="$1"
  [[ -f "$f" ]] && [[ "$(basename "$f")" =~ \.(${VIDEO_EXTS})$ ]] && return 0
  return 1
}

# Baraka.1992.1080p... -> Baraka_1992_1280x720_vj.mp4
output_name_for() {
  local path="$1"
  local base stem title year part
  base=$(basename "$path")
  stem="${base%.*}"
  title="${stem%%.*}"
  title=$(vj_sanitize_title "$title" 48)
  year=""
  IFS='.' read -ra parts <<< "$stem"
  for part in "${parts[@]}"; do
    if [[ "$part" =~ ^[0-9]{4}$ ]]; then
      year="$part"
      break
    fi
  done
  if [[ -n "$year" ]]; then
    echo "${title}_${year}_${RES_TAG}_vj.mp4"
  else
    echo "${title}_${RES_TAG}_vj.mp4"
  fi
}

# Folder under Converted_media_files for this source (movie / clip group name).
output_collection_dir_for() {
  local src="$1" parent stem movie=""
  parent=$(basename "$(dirname "$src")")
  stem=$(basename "${src%.*}")

  if [[ "$parent" == *_clips ]]; then
    movie=${parent%_clips}
    vj_split_sanitize "$movie"
    return 0
  fi

  if [[ "$stem" == *"__"* && "$stem" == *_to_* ]]; then
    vj_split_group_key "$src"
    return 0
  fi

  if [[ "$stem" =~ ^(.+)_[0-9]{2}-[0-9]{2}-[0-9]{2}_to_[0-9]{2}-[0-9]{2}-[0-9]{2}$ ]]; then
    vj_split_sanitize "${BASH_REMATCH[1]}"
    return 0
  fi

  movie=$(output_collection_name "$src")
  vj_split_sanitize "$movie"
}

output_collection_name() {
  local path="$1" base stem title year part
  base=$(basename "$path")
  stem="${base%.*}"
  if [[ "$stem" == *"."* ]]; then
    title="${stem%%.*}"
    title=$(vj_sanitize_title "$title" 64)
    year=""
    IFS='.' read -ra parts <<< "$stem"
    for part in "${parts[@]}"; do
      if [[ "$part" =~ ^[0-9]{4}$ ]]; then
        year="$part"
        break
      fi
    done
    if [[ -n "$year" ]]; then
      echo "${title}_${year}"
    else
      echo "${title}"
    fi
    return 0
  fi

  local id=""
  id=$(vj_split_youtube_id "$path" 2>/dev/null || true)
  title=$(vj_split_sanitize "$stem")
  title=${title%_1280x720_vj}
  if [[ -n "$id" && "$title" == *"_"$id ]]; then
    title=${title%_"$id"}
  fi
  if [[ ${#title} -gt 80 ]]; then
    title=$(vj_split_shorten_to "$title" 80)
  fi
  echo "$title"
}

find_valid_vj_output() {
  local out_name="$1" dir candidate
  shift
  for dir in "$@"; do
    [[ -n "$dir" ]] || continue
    candidate="${dir}/${out_name}"
    if [[ -f "$candidate" ]] && is_valid_vj_output "$candidate"; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

# Koyaanisqatsi.1982.REMASTERED... -> Koyaanisqatsi_1982_REMASTERED_1080p_vj-processed_org_file.<ext>
archive_name_for() {
  local path="$1"
  local base stem ext sanitized suffix max=100
  base=$(basename "$path")
  ext="${base##*.}"
  stem="${base%.*}"
  sanitized=$(vj_sanitize_title "$stem" 80)
  suffix="_vj-processed_org_file"
  max=100
  if ((${#sanitized} + ${#suffix} > max)); then
    sanitized="${sanitized:0:max - ${#suffix}}"
  fi
  echo "${sanitized}${suffix}.${ext}"
}

unique_path() {
  local dir="$1" name="$2"
  local candidate="${dir}/${name}" n=2 base ext
  if [[ ! -e "$candidate" ]]; then
    echo "$candidate"
    return
  fi
  base="${name%.*}"
  ext="${name##*.}"
  while [[ -e "${dir}/${base}_${n}.${ext}" ]]; do
    n=$((n + 1))
  done
  echo "${dir}/${base}_${n}.${ext}"
}

is_valid_vj_output() {
  local f="$1"
  local w h vcodec audio_n
  [[ -f "$f" ]] || return 1
  w=$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 "$f" 2>/dev/null) || return 1
  h=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$f" 2>/dev/null) || return 1
  vcodec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$f" 2>/dev/null) || return 1
  audio_n=$(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 "$f" 2>/dev/null | wc -l | tr -d ' ')
  [[ "$w" == "$VJ_W" && "$h" == "$VJ_H" && "$vcodec" == "h264" && "$audio_n" == "0" ]]
}

encode_vj() {
  local in="$1" out="$2"
  local tmp="${CACHE}/convert-vj.$$.mp4"
  vj_run_ffmpeg -y -i "$in" \
    -an \
    -vf "scale=${VJ_W}:${VJ_H}:force_original_aspect_ratio=decrease,pad=${VJ_W}:${VJ_H}:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=fps='min(source_fps\,24)'" \
    -c:v libx264 -pix_fmt yuv420p -profile:v high -level:v 4.0 \
    -crf 18 -preset fast \
    -movflags +faststart \
    "$tmp" >>"$LOG" 2>&1
  mv -f "$tmp" "$out"
}

remove_sidecars_in_dir() {
  local dir="$1" keep="$2" f
  for f in "$dir"/*; do
    [[ -e "$f" ]] || continue
    [[ -f "$f" ]] || continue
    [[ "$f" == "$keep" ]] && continue
    if is_video_file "$f"; then
      continue
    fi
    rm -f "$f"
    log "Removed sidecar: $f"
  done
}

prune_empty_dirs() {
  find "$INBOX" -depth -type d -empty ! -path "$INBOX" -delete 2>/dev/null || true
}

process_file_return() {
  local rc="${1:-0}"
  vj_maybe_stop_after_current "$JOB" "$LOG" "Local VJ convert"
  return "$rc"
}

process_file() {
  local src="$1" out_name out_dir out_path archive_name archive_path parent existing

  if ! is_video_file "$src"; then
    return 0
  fi

  out_name=$(output_name_for "$src")
  out_dir="${OUTBOX}/$(output_collection_dir_for "$src")"
  mkdir -p "$out_dir"
  out_path=$(unique_path "$out_dir" "$out_name")

  if existing=$(find_valid_vj_output "$out_name" "$out_dir" "$OUTBOX"); then
    log "SKIP encode (valid output exists): ${existing}"
    out_path="$existing"
  elif is_valid_vj_output "$out_path"; then
    log "SKIP encode (valid output exists): $out_path"
  else
    vj_state_set "$JOB" PHASE "encoding"
    vj_state_set "$JOB" CURRENT "$(basename "$src")"
    log "ENCODE: $src -> $out_path"
    if ! encode_vj "$src" "$out_path"; then
      log "FAIL encode: $src"
      process_file_return 1
    fi
    log "OK: $out_path"
  fi

  parent=$(dirname "$src")
  archive_name=$(archive_name_for "$src")
  archive_path=$(unique_path "$ARCHIVE" "$archive_name")

  if [[ -f "$src" ]]; then
    log "ARCHIVE source -> $archive_path"
    mv -f "$src" "$archive_path"
  fi

  remove_sidecars_in_dir "$parent" ""
  vj_bump_done "$JOB"
  process_file_return 0
}

main() {
  vj_job_acquire_pid "$JOB"
  if [[ "${VJ_BACKGROUND:-}" != "1" ]]; then
    vj_print_job_banner "Local VJ convert" "make convert-vj-status" "$LOG"
  fi
  log "convert-vj started (inbox: $INBOX)"
  local -a files=()
  while IFS= read -r -d '' f; do
    files+=("$f")
  done < <(find "$INBOX" -type f \( \
    -iname '*.mp4' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.avi' \
    -o -iname '*.webm' -o -iname '*.m4v' -o -iname '*.mpg' -o -iname '*.mpeg' \
    -o -iname '*.wmv' -o -iname '*.flv' -o -iname '*.ts' -o -iname '*.m2ts' \
    \) -print0 2>/dev/null)

  vj_state_set "$JOB" TOTAL "${#files[@]}"
  vj_state_set "$JOB" DONE "0"
  vj_state_set "$JOB" PHASE "starting"
  vj_state_set "$JOB" CURRENT ""
  vj_state_set "$JOB" STOP_AFTER 0

  if ((${#files[@]} == 0)); then
    log "No video files found in $INBOX"
    vj_state_set "$JOB" PHASE "finished"
    vj_print_summary "$JOB" "$LOG" "Local VJ convert"
    exit 0
  fi

  local f
  for f in "${files[@]}"; do
    vj_maybe_stop_after_current "$JOB" "$LOG" "Local VJ convert"
    vj_state_set "$JOB" CURRENT "$(basename "$f")"
    vj_state_set "$JOB" PHASE "processing"
    process_file "$f" || true
  done

  prune_empty_dirs
  vj_state_set "$JOB" PHASE "finished"
  vj_state_set "$JOB" CURRENT ""
  log "convert-vj finished"
  vj_print_summary "$JOB" "$LOG" "Local VJ convert"
}

main "$@"
