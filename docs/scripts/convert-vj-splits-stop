#!/bin/bash
# Signal the splitter first so it can keep finished clips and drop the one
# still being written. Killing ffmpeg directly would skip that cleanup.
set -euo pipefail
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=vj-job-common.sh
source "${SCRIPT_DIR}/vj-job-common.sh"
vj_job_stop_graceful "convert-vj-splits"
